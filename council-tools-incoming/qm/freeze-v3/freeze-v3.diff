 def say(msg): print(msg, flush=True)
 
+# ---------------------------------------------------------------- render routing (v3, QM ruling on Auditor point 2)
+SEND_DIRS = ('sheets', 'showcase')
+IMG_EXT = ('.png', '.jpg', '.jpeg', '.webp', '.gif')
+def route(rel):
+    """'sheets' if any directory of the stage-relative path is named exactly sheets or showcase (any depth, e.g.
+    scene-fill-20261101/sheets/S01.png or sheets/sub/x.png): judged ONLY by the sheets scan, never by ground_check.
+    'single' otherwise: unchanged from 91aa8a3e."""
+    parts = rel[2:].split('/') if rel.startswith('./') else rel.split('/')
+    return 'sheets' if any(x in SEND_DIRS for x in parts[:-1]) else 'single'
+def is_image(p):
+    try: head = open(p, 'rb').read(8)
+    except OSError: return False
+    return p.lower().endswith(IMG_EXT) or head.startswith(b'\x89PNG') or head.startswith(b'\xff\xd8\xff')
+def send_files(stage):
+    """(sorted files routed 'sheets', sorted send_guard --only prefixes cut at the first sheets/showcase folder)."""
+    files, prefixes = [], set()
+    for rel, p in file_map(stage).items():
+        if route(rel) != 'sheets': continue
+        parts = rel[2:].split('/'); i = next(k for k, x in enumerate(parts[:-1]) if x in SEND_DIRS)
+        files.append(p); prefixes.add('/'.join(parts[:i + 1]) + '/')
+    return sorted(files), sorted(prefixes)
+
