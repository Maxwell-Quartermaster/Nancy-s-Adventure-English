+    if not path1b or not os.path.isfile(path1b): raise ValueError(f'pointer paste_1b file missing: {path1b or "(no paste_1b_path)"}')
+    if not same(md(path1b),want): raise ValueError(f'pointer paste_1b {want[:8]} != disk {md(path1b)[:8]} at {path1b}')
+    return ptr,want
