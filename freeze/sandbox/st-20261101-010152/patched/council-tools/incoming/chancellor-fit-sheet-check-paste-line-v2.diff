+LINE=re.compile(r'^PASTE for this sheet: ([0-9a-f]{32})\s*$',re.M)
+RANK={0:0,3:1,1:2,2:3}
+def md(p):
+    h=hashlib.md5()
+    with open(p,'rb') as f:
+        for b in iter(lambda:f.read(1<<20),b''): h.update(b)
+    return h.hexdigest()
+def same(a,b): n=min(len(a),len(b)); return n>=8 and a[:n].lower()==b[:n].lower()
+def judge(text,want,cand=None):
+    """-> (exit, label, reason). want = pointer paste_1b md5; cand = --candidate file md5 or None."""
+    m=LINE.findall(text)
+    if not m: return 1,'STALE','no PASTE line'
+    if len(set(m))>1: return 1,'STALE','several different PASTE lines: '+', '.join(sorted(set(m)))
+    got=m[0]
+    if cand is not None:
+        if got==cand: return 3,'CANDIDATE (NOT valid for a send)',f'PASTE {got[:8]} = --candidate file md5 {cand[:8]}'
+        return 1,'STALE',f'mismatch: sheet PASTE {got[:8]} vs --candidate file md5 {cand[:8]}'
+    if same(got,want): return 0,'CURRENT',f'PASTE {got[:8]} = pointer paste_1b {want[:8]}'
+    return 1,'STALE',f'mismatch: sheet PASTE {got[:8]} vs pointer paste_1b {want[:8]}'
+def load_pointer(path):
+    """-> (ptr, want) or raises ValueError with a clear message."""
+    if not os.path.isfile(path): raise ValueError(f'pointer {path} missing')
+    try: ptr=cs.read(path)
