"""fit_sheet_check.py - Owner: Chancellor. Refuses a fit/cost sheet unless it names the
CURRENT pointer's paste_1b md5 (first 8 chars) and that file is on disk at that md5.
Usage: python3 fit_sheet_check.py SHEET.md [...]   exit 0 = CURRENT, 1 = STALE, 2 = pointer error."""
import sys,os,hashlib
HERE=os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0,os.path.dirname(HERE))
import current_snap as cs
def md(p): return hashlib.md5(open(p,'rb').read()).hexdigest()
try:
    ptr=cs.read(); probs=cs.verify(ptr)
except Exception as e: print(f"POINTER ERROR: {e}"); sys.exit(2)
if probs: print("POINTER ERROR: "+"; ".join(probs)); sys.exit(2)
want=ptr.get("paste_1b_md5","")[:8]
path=os.path.join(os.path.dirname(ptr["snap_dir"].rstrip("/")),ptr.get("paste_1b_path","").split()[0]) if ptr.get("paste_1b_path") else ""
if not want or not os.path.exists(path) or md(path)[:8]!=want: print(f"POINTER ERROR: paste_1b {want} missing or md5 mismatch at {path}"); sys.exit(2)
print(f"fit_sheet_check {md(__file__)[:8]} pointer {ptr['pointer_md5'][:8]} snap {ptr['snap']} paste_1b {want}")
bad=0
for s in sys.argv[1:]:
    t=open(s,encoding='utf-8').read()
    ok=want in t
    print(f"{'CURRENT' if ok else 'STALE  '} {s} ({md(s)[:8]})" + ("" if ok else f": does not name paste_1b {want}"))
    bad|=not ok
sys.exit(1 if bad else 0)
